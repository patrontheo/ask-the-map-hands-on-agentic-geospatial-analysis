# Workshop app — get the endpoint, deployment name and key from the organisers.
# Use the resource-level OpenAI v1 base URL, ending in /openai/v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna-pat-ws-gis-ams

# Optional app settings (existing defaults; these don't configure coding assistants).
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_S=60
MAX_MODEL_CALLS=16

# Codex / Luna: leave the URL empty to reuse LLM_BASE_URL.
# If different, use the full resource-level base URL ending in /openai/v1.
LUNA_OPENAI_BASE_URL=
LUNA_DEPLOYMENT=gpt-6-luna-pat-ws-gis-ams

# Claude Code / Haiku: full Foundry base URL ending in /anthropic.
# Claude Code appends /v1/messages itself; omit that suffix here.
HAIKU_ANTHROPIC_BASE_URL=
HAIKU_DEPLOYMENT=claude-haiku-5-5
