#!/usr/bin/env bash
# Claude Code using the workshop's Haiku deployment on Azure AI Foundry.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_load_env.sh
. "$SCRIPT_DIR/_load_env.sh"
load_config haiku

command -v claude >/dev/null || { echo "error: claude CLI not found on PATH; see coding-assistant/README.md" >&2; exit 1; }

# Clear competing providers and credentials before selecting Microsoft Foundry.
unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_MANTLE CLAUDE_CODE_USE_ANTHROPIC_AWS \
      ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_DEFAULT_MODEL \
      ANTHROPIC_FOUNDRY_AUTH_TOKEN ANTHROPIC_FOUNDRY_RESOURCE

export CLAUDE_CODE_USE_FOUNDRY=1
export ANTHROPIC_FOUNDRY_BASE_URL="$HAIKU_ANTHROPIC_BASE_URL"
export ANTHROPIC_FOUNDRY_API_KEY="$AZURE_FOUNDRY_API_KEY"

# Keep model aliases and subagents on the one provisioned deployment.
export ANTHROPIC_MODEL="$HAIKU_DEPLOYMENT"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$HAIKU_DEPLOYMENT"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$HAIKU_DEPLOYMENT"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$HAIKU_DEPLOYMENT"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$HAIKU_DEPLOYMENT"
export CLAUDE_CODE_SUBAGENT_MODEL="$HAIKU_DEPLOYMENT"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

unset AZURE_FOUNDRY_API_KEY
cd "$REPO_ROOT"
exec claude "$@"
