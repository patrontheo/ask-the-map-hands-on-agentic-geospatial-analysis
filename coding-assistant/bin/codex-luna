#!/usr/bin/env bash
# Codex CLI using the workshop's Luna deployment on Azure AI Foundry.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_load_env.sh
. "$SCRIPT_DIR/_load_env.sh"
load_config luna

command -v codex >/dev/null || { echo "error: codex CLI not found on PATH; see coding-assistant/README.md" >&2; exit 1; }

# TOML literal strings keep the URL literal. URLs must not contain these characters.
case "$LUNA_OPENAI_BASE_URL" in
  *\'*|*$'\n'*|*$'\r'*) echo "error: invalid LUNA_OPENAI_BASE_URL in .env" >&2; exit 1 ;;
esac

# Workshop default: no approval prompts. Commands run in the workspace sandbox and
# anything outside it is refused at once (Codex's automatic review is unavailable
# on the workshop endpoint). ASSISTANT_AUTO=0 asks instead.
AUTO_ARGS=()
if [ "${ASSISTANT_AUTO:-1}" != 0 ]; then
  AUTO_ARGS=(--sandbox workspace-write --ask-for-approval never)
  # Let `uv run` (tests, the app) use its cache from inside the sandbox.
  UV_CACHE="$(uv cache dir 2>/dev/null || true)"
  case "$UV_CACHE" in
    ""|*\'*|*$'\n'*) ;;
    *) AUTO_ARGS+=(-c "sandbox_workspace_write.writable_roots=['$UV_CACHE']") ;;
  esac
fi

cd "$REPO_ROOT"
exec codex \
  -c 'model_provider="luna"' \
  -c "model_providers.luna={name='Luna (Azure)', base_url='$LUNA_OPENAI_BASE_URL', env_key='AZURE_FOUNDRY_API_KEY', wire_api='responses', requires_openai_auth=false}" \
  -c 'model_reasoning_effort="medium"' \
  ${AUTO_ARGS[@]+"${AUTO_ARGS[@]}"} \
  -m "$LUNA_DEPLOYMENT" \
  "$@"
